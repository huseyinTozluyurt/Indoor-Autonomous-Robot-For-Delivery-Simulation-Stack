<?xml version="1.0"?>
<package format="3">
  <name>indoor_delivery_project</name>
  <version>0.0.1</version>
  <description>Indoor autonomous delivery project with custom Gazebo world and RB1-based delivery robot.</description>

  <maintainer email="huseyintozluyurt@hotmail.com">Huseyin Tozluyurt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>

  <depend>indoor_delivery_robot_description</depend>
  <depend>robotnik_description</depend>
  <depend>robotnik_sensors</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>