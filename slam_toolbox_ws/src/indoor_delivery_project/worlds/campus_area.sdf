            <diffuse>0.3 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= RIGHT ROOM WALLS ================= -->

    <!-- East wall -->
    <model name="right_room_east_wall">
      <static>true</static>
      <pose>35 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 50 3</size></box>
