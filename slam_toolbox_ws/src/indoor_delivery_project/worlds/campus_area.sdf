        </visual>
      </link>
    </model>

    <!-- ================= BRIDGE WALLS ================= -->

    <!-- Bridge north wall -->
    <model name="bridge_north_wall">
      <static>true</static>
      <pose>0 2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 0.3 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 0.3 3</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bridge south wall -->
    <model name="bridge_south_wall">
      <static>true</static>
      <pose>0 -2 1.5 0 0 0</pose>
      <link name="link">
