      </link>
    </model>




    <!-- ================= DELIVERY POINTS ================= -->
    <!-- Opposite to corridor side:
         Left room  -> near west wall
         Right room -> near east wall
    -->

    <!-- LEFT ROOM DELIVERY POINTS -->
    <model name="left_delivery_point_1">
      <static>true</static>
      <pose>-32.5 -18 0.06 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.85 0.1 1</ambient>
            <diffuse>1.0 0.85 0.1 1</diffuse>
            <emissive>0.15 0.12 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="left_delivery_point_2">
      <static>true</static>
      <pose>-32.5 -6 0.06 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.8</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.85 0.1 1</ambient>
            <diffuse>1.0 0.85 0.1 1</diffuse>
            <emissive>0.15 0.12 0.02 1</emissive>
