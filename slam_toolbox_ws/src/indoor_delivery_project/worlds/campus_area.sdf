    </model>

    <model name="left_room_east_wall_top">
      <static>true</static>
      <pose>-15 13.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 23 3</size></box>
          </geometry>
        </collision>
